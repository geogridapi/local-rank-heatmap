      "parameters": {
        "errorMessage": "=Grid {{ $json.id }} ended as \"{{ $json.status }}\": {{ (typeof $json.error === 'string' ? $json.error : $json.error?.message) ?? 'still running after 20 checks, see it in the GeoGridAPI console' }}. A failed grid is refunded automatically."
