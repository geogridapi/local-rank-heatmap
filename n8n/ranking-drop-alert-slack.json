    {
      "id": "f5de4510-a248-520d-8030-141b678b121c",
      "name": "Compare with last grid",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1880,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Compares with the previous grid of the same map (same listing, keyword, size and radius).\nconst settings = $('Settings').first().json;\nconst grid = $json;\nconst { summary, previous, points_total: total } = grid;\n\n// Names come from Google Maps: escape them before putting them in HTML or Slack markup.\nconst escape = (text) => String(text ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst ahead = (grid.competitors || [])\n  .filter((c) => c.ahead_points > 0)\n  .sort((a, b) => b.ahead_points - a.ahead_points)\n  .slice(0, 3)\n  .map((c) => `${escape(c.name)} (${c.ahead_points} points)`)\n  .join(', ') || 'nobody';\n\nconst reasons = [];\nif (previous) {\n  const { changes } = previous;\n  if (previous.average_rank !== null && summary.average_rank === null) reasons.push('no longer in the top 20 anywhere');\n  if (changes.average_rank !== null && changes.average_rank >= settings.rankDrop) reasons.push(`average rank +${changes.average_rank}`);\n  if (changes.top3_points <= -settings.top3Drop) reasons.push(`${-changes.top3_points} fewer points in the top 3`);\n  if (changes.found_points <= -settings.foundDrop) reasons.push(`${-changes.found_points} fewer points in the top 20`);\n}\n\nconst text = [\n  `:chart_with_downwards_trend: *${escape(grid.place.name)}* dropped on Google Maps for “${escape(grid.keyword)}”: ${reasons.join(', ')}.`,\n  `Average rank where found: ${previous?.average_rank ?? '20+'} → *${summary.average_rank ?? '20+'}*`,\n  `Top 3: ${previous?.top3_points ?? 0} → *${summary.top3_points}* of ${total} points`,\n  `Top 20: ${previous?.found_points ?? 0} → *${summary.found_points}* of ${total} points`,\n  `Ranking ahead most often: ${ahead}`,\n  `Grid ${grid.id}, measured with GeoGridAPI.`,\n].join('\\n');\n\nreturn { json: { ...grid, dropped: reasons.length > 0, reasons, text } };"
      }
    },
